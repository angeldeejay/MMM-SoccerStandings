{
  "name": "MMM-SoccerStandings",
  "version": "3.0.2",
  "description": "A MagicMirror² module for API-first football standings and tournament views",
  "main": "MMM-SoccerStandings.js",
  "keywords": [
    "MagicMirror",
    "module",
    "SPFL",
    "Scottish Premier League",
    "football",
    "soccer",
    "league table",
    "standings",
    "sports",
    "Celtic"
  ],
  "author": {
    "name": "Andrés Vanegas Jiménez",
    "url": "https://github.com/angeldeejay"
  },
  "license": "MIT",
  "homepage": "https://github.com/angeldeejay/MMM-SoccerStandings",
  "repository": {
    "type": "git",
    "url": "https://github.com/angeldeejay/MMM-SoccerStandings.git"
  },
  "bugs": {
    "url": "https://github.com/angeldeejay/MMM-SoccerStandings/issues"
  },
  "engines": {
    "node": ">=14.0.0"
  },
  "overrides": {
    "serialize-javascript": "^7.0.5"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@fortawesome/fontawesome-free": "^7.2.0",
    "@mswjs/http-middleware": "^0.10.3",
    "chokidar": "^5.0.0",
    "eslint": "^10.2.1",
    "express": "^5.2.1",
    "globals": "^17.5.0",
    "mocha": "^12.0.0-beta-3",
    "moment": "^2.30.1",
    "moment-timezone": "^0.6.1",
    "msw": "^2.14.3",
    "prettier": "^3.8.3",
    "sass": "^1.99.0",
    "socket.io": "^4.8.3",
    "tsx": "^4.21.0"
  },
  "sandbox": {
    "startup": [
      "mock-api:start"
    ]
  },
  "scripts": {
    "test": "mocha \"tests/*.test.js\" --timeout 10000",
    "lint": "eslint *.js constants/*.js providers/*.js backend/*.js backend/providers/*.js tests/*.js tools/espn-service-mock/*.ts",
    "format": "prettier --write *.js constants/*.js providers/*.js backend/*.js backend/providers/*.js tests/*.js tools/espn-service-mock/*.ts *.json *.md",
    "audit": "npm audit --audit-level=moderate",
    "audit:fix": "npm audit fix",
    "postinstall": "sass --style=compressed scss/entrypoint.scss MMM-SoccerStandings.css",
    "scss:build": "sass --style=compressed scss/entrypoint.scss MMM-SoccerStandings.css",
    "scss:watch": "sass --watch scss/entrypoint.scss:MMM-SoccerStandings.css",
    "mock-api:start": "tsx tools/espn-service-mock/server.ts",
    "sandbox:start": "magicmirror-module-sandbox",
    "sandbox:watch": "magicmirror-module-sandbox --watch"
  },
  "magicmirror": {
    "moduleName": "MMM-SoccerStandings",
    "moduleVersion": "1.0.0",
    "requiredVersion": "2.1.0"
  }
}
